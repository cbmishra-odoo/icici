<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_icici_irm_list" model="ir.ui.view">
        <field name="name">icici.irm.list</field>
        <field name="model">icici.irm</field>
        <field name="arch" type="xml">
            <list>
                <field name="remittance_ref_no"/>
                <field name="remittance_date"/>
                <field name="settled_count"/>
                <field name="last_fetched"/>
            </list>
        </field>
    </record>

    <record id="view_icici_irm_search" model="ir.ui.view">
        <field name="name">icici.irm.search</field>
        <field name="model">icici.irm</field>
        <field name="arch" type="xml">
            <search>
                <field name="remittance_ref_no"/>
                <field name="remittance_date"/>
                <field name="settled_count"/>
            </search>
        </field>
    </record>

    <record id="view_icici_irm_form" model="ir.ui.view">
        <field name="name">icici.irm.form</field>
        <field name="model">icici.irm</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fetch_settled" type="object" string="Fetch Settled Details" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_settled" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="settled_count == 0">
                            <field name="settled_count" widget="statinfo" string="Settled IRM"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="remittance_ref_no"/></h1>
                    </div>
                    <group>
                        <group>
                        <field name="remittance_ref_no"/>
                        </group>
                        <group>
                        <field name="remittance_date"/>
                            <field name="last_fetched"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="API Response" name="api_response">
                            <field name="raw_response"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_icici_irm" model="ir.actions.act_window">
        <field name="name">IRM List</field>
        <field name="res_model">icici.irm</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
