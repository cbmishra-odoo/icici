<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_icici_outstanding_remittance_list" model="ir.ui.view">
        <field name="name">icici.outstanding.remittance.list</field>
        <field name="model">icici.outstanding.remittance</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="grs_reference_no"/>
                <field name="credit_advice_value_date"/>
                <field name="currency_code"/>
                <field name="amount"/>
                <field name="outstanding_amount"/>
                <field name="transaction_status"/>
                <field name="ordering_customer_details"/>
                <field name="ie_code"/>
            </list>
        </field>
    </record>

    <record id="view_icici_outstanding_remittance_search" model="ir.ui.view">
        <field name="name">icici.outstanding.remittance.search</field>
        <field name="model">icici.outstanding.remittance</field>
        <field name="arch" type="xml">
            <search>
                <field name="grs_reference_no"/>
                <field name="credit_advice_value_date"/>
                <field name="currency_code"/>
            </search>
        </field>
    </record>

    <record id="view_icici_outstanding_remittance_form" model="ir.ui.view">
        <field name="name">icici.outstanding.remittance.form</field>
        <field name="model">icici.outstanding.remittance</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="grs_reference_no"/></h1>
                    </div>
                    <group>
                        <group>
                        <field name="grs_reference_no"/>
                        <field name="credit_accounts"/>
                        <field name="transaction_type"/>
                        <field name="transaction_status"/>
                        <field name="senders_reference"/>
                        <field name="currency_code"/>
                        <field name="usd_equivalent"/>
                        <field name="ordering_customer"/>
                        <field name="ordering_institution"/>
                        <field name="beneficiary_customer"/>
                        <field name="remittance_information"/>
                        <field name="sender_to_receiver_information"/>
                        <field name="servicing_institution_reference"/>
                        <field name="value_date"/>
                        <field name="nostro"/>
                        <field name="account_number"/>
                        <field name="bill_id"/>
                        <field name="other_party_details"/>
                        <field name="charges_borne_by"/>
                        <field name="ordering_institution_country"/>
                        </group>
                        <group>
                        <field name="customer_id"/>
                        <field name="gst_details"/>
                        <field name="ie_code"/>
                        <field name="authoriser_remarks"/>
                        <field name="credit_advice_value_date"/>
                        <field name="amount"/>
                        <field name="credit_advice_nostro"/>
                        <field name="ordering_customer_details"/>
                        <field name="senders_correspondent"/>
                        <field name="beneficiary_customer_details"/>
                        <field name="account_with_institution"/>
                        <field name="deal_amount"/>
                        <field name="reference_number"/>
                        <field name="supplementary_details"/>
                        <field name="information_to_account_owner"/>
                        <field name="account_description"/>
                        <field name="outstanding_amount"/>
                        <field name="hub_branch"/>
                        <field name="remarks"/>
                        <field name="ordering_customer_country"/>
                            <field name="last_fetched"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="API Response" name="api_response">
                            <field name="raw_response"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_icici_outstanding_remittance" model="ir.actions.act_window">
        <field name="name">Outstanding Remittance</field>
        <field name="res_model">icici.outstanding.remittance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
